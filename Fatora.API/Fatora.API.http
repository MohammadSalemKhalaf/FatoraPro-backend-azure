@refreshToken = PASTE_REFRESH_TOKEN_HERE
@salesRepToken =eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIyYTM2MTExNC1hYWI5LTQzYjgtODQ2Mi1hMzlhNjhhMzViZjEiLCJyb2xlIjoiU2FsZXNSZXAiLCJuYmYiOjE3ODQxMjcxNzAsImV4cCI6MTc4NDEyNzc3MCwiaWF0IjoxNzg0MTI3MTcwLCJpc3MiOiJsb2NhbGhvc3QiLCJhdWQiOiJsb2NhbGhvc3QifQ.OCJBFDWz56egodvEanBU8scHkY2XUCHVddl5Tu4OPDU





### 1) Login as Admin
# The only account seeded automatically (see appsettings.json -> AdminSeed). Change the
# password afterward via reset-password if this ever runs against a real deployment.
POST {{baseUrl}}/api/account/login
content-Type: application/json

{
  "UserName":"mbaboshi",
  "Password":"azah1342"
}

### 2) Admin creates a new Sales Rep account
# Paste the "accessToken" from step 1's response into the @adminToken variable above first.
POST {{baseUrl}}/api/users/sales-reps
content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "UserName":"newrep",
  "Password":"Password123",
  "Name":"New Rep",
  "PhoneNumber":"0799000099",
  "BusinessName":"New Store",
  "City":"Amman",
  "Street":"Rainbow Street"
}

### 3) Sales Rep logs in directly with the username/password the Admin just set
POST {{baseUrl}}/api/account/login
content-Type: application/json

{
  "UserName":"newrep",
  "Password":"Password123"
}

### 4) Use a refresh token to get a new access token (rotates the refresh token too)
# Paste the "refreshToken" from any login response above into @refreshToken.
POST {{baseUrl}}/api/account/refresh-token
content-Type: application/json

{
  "RefreshToken":"{{refreshToken}}"
}

### 5) Sales Rep creates a product
# Paste a SalesRep's "accessToken" (e.g. from step 3) into @salesRepToken above.
POST {{baseUrl}}/api/products
content-Type: application/json
Authorization: Bearer {{salesRepToken}}

{
  "Name":"Phone Case",
  "Description":"Durable silicone phone case",
  "ImageUrl":"https://example.com/phone-case.png",
  "PurchasePrice":5,
  "SellPrice":15
}

### 6) Sales Rep lists their own products
GET {{baseUrl}}/api/products
Authorization: Bearer {{salesRepToken}}

### 7) Sales Rep gets a single product by id
GET {{baseUrl}}/api/products/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{salesRepToken}}

### 8) Sales Rep updates a product
PUT {{baseUrl}}/api/products/00000000-0000-0000-0000-000000000000
content-Type: application/json
Authorization: Bearer {{salesRepToken}}

{
  "Name":"Phone Case v2",
  "Description":"Durable silicone phone case, now reinforced",
  "ImageUrl":"https://example.com/phone-case-v2.png",
  "PurchasePrice":6,
  "SellPrice":18
}

### 9) Sales Rep deletes (soft-deletes) a product
DELETE {{baseUrl}}/api/products/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{salesRepToken}}

### 10) Sales Rep creates a customer
POST {{baseUrl}}/api/customers
content-Type: application/json
Authorization: Bearer {{salesRepToken}}

{
  "Name":"Abu Khalil",
  "StoreName":"Khalil Shop",
  "PhoneNumber":"0791112233",
  "Street":"Main St",
  "City":"Amman"
}

### 11) Sales Rep lists their own customers
GET {{baseUrl}}/api/customers
Authorization: Bearer {{salesRepToken}}

### 12) Sales Rep gets a single customer by id
GET {{baseUrl}}/api/customers/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{salesRepToken}}

### 13) Sales Rep updates a customer
PUT {{baseUrl}}/api/customers/00000000-0000-0000-0000-000000000000
content-Type: application/json
Authorization: Bearer {{salesRepToken}}

{
  "Name":"Abu Khalil",
  "StoreName":"Khalil Shop 2",
  "PhoneNumber":"0791112233",
  "Street":"New St",
  "City":"Amman"
}

### 14) Sales Rep deletes (soft-deletes) a customer
DELETE {{baseUrl}}/api/customers/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{salesRepToken}}

### 15) List archived (soft-deleted) products
GET {{baseUrl}}/api/products/archived
Authorization: Bearer {{salesRepToken}}

### 16) Restore an archived product
POST {{baseUrl}}/api/products/00000000-0000-0000-0000-000000000000/restore
Authorization: Bearer {{salesRepToken}}

### 17) Permanently delete a product (irreversible)
DELETE {{baseUrl}}/api/products/00000000-0000-0000-0000-000000000000/permanent
Authorization: Bearer {{salesRepToken}}

### 18) List archived (soft-deleted) customers
GET {{baseUrl}}/api/customers/archived
Authorization: Bearer {{salesRepToken}}

### 19) Restore an archived customer
POST {{baseUrl}}/api/customers/00000000-0000-0000-0000-000000000000/restore
Authorization: Bearer {{salesRepToken}}

### 20) Permanently delete a customer (irreversible)
DELETE {{baseUrl}}/api/customers/00000000-0000-0000-0000-000000000000/permanent
Authorization: Bearer {{salesRepToken}}

### 21) Sales Rep creates an order (invoice) with line items and a discount
POST {{baseUrl}}/api/orders
content-Type: application/json
Authorization: Bearer {{salesRepToken}}

{
  "CustomerId":"00000000-0000-0000-0000-000000000000",
  "DueDate":"2026-08-01",
  "Discount":10,
  "CashDiscount":0,
  "Notes":"Test order",
  "Items":[
    {"ProductId":"00000000-0000-0000-0000-000000000000","Quantity":2}
  ]
}

### 22) Sales Rep lists their own orders
GET {{baseUrl}}/api/orders
Authorization: Bearer {{salesRepToken}}

### 23) Sales Rep gets a single order by id
GET {{baseUrl}}/api/orders/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{salesRepToken}}

### 24) Sales Rep updates an order (replaces line items)
# CashDiscount rounds off loose change (e.g. a 706 total becomes 700) - independent of the
# percentage Discount above, and optional/defaults to 0 if omitted entirely.
PUT {{baseUrl}}/api/orders/00000000-0000-0000-0000-000000000000
content-Type: application/json
Authorization: Bearer {{salesRepToken}}

{
  "CustomerId":"00000000-0000-0000-0000-000000000000",
  "DueDate":"2026-08-15",
  "Discount":0,
  "CashDiscount":6,
  "Notes":"Updated order",
  "Items":[
    {"ProductId":"00000000-0000-0000-0000-000000000000","Quantity":1}
  ]
}

### 25) Record a payment against an order (directly updates PaidAmount, no payment history is kept)
POST {{baseUrl}}/api/orders/00000000-0000-0000-0000-000000000000/record-payment
content-Type: application/json
Authorization: Bearer {{salesRepToken}}

{
  "Amount":30
}

### 26) Delete an order (permanent, cascades to its line items)
# WARNING: irreversible. The sales rep is responsible for this decision.
DELETE {{baseUrl}}/api/orders/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{salesRepToken}}

### 27) Dashboard summary (all time)
GET {{baseUrl}}/api/orders/summary
Authorization: Bearer {{salesRepToken}}

### 28) Dashboard summary (period-filtered: Week, Month, Year, or All)
GET {{baseUrl}}/api/orders/summary?period=Month
Authorization: Bearer {{salesRepToken}}

### 29) Sales report (time-bucketed)
GET {{baseUrl}}/api/reports/sales?period=Week
Authorization: Bearer {{salesRepToken}}

### 30) Items report (Most sold or Top value)
GET {{baseUrl}}/api/reports/items?period=All&sortBy=MostSold
Authorization: Bearer {{salesRepToken}}

### 31) Clients report (Most invoices or Top value)
GET {{baseUrl}}/api/reports/clients?period=All&sortBy=MostInvoices
Authorization: Bearer {{salesRepToken}}

### 32) Get own profile (business name, logo, bank details)
GET {{baseUrl}}/api/profile
Authorization: Bearer {{salesRepToken}}

### 33) Update bank details
PUT {{baseUrl}}/api/profile/bank-details
content-Type: application/json
Authorization: Bearer {{salesRepToken}}

{
  "BankName":"Cairo Amman Bank",
  "AccountNumber":"123456",
  "IBAN":"JO71CAAB1234567890123456789012"
}

### 34) Logout (revokes the Sales Rep's active refresh token)
POST {{baseUrl}}/api/account/logout
Authorization: Bearer {{salesRepToken}}

### 35) Change password (while logged in)
POST {{baseUrl}}/api/account/change-password
content-Type: application/json
Authorization: Bearer {{salesRepToken}}

{
  "CurrentPassword":"Password123",
  "NewPassword":"NewPassword456"
}

### 36) Admin suspends a Sales Rep (blocks login, does NOT delete data)
POST {{baseUrl}}/api/users/00000000-0000-0000-0000-000000000000/suspend
Authorization: Bearer {{adminToken}}

### 37) Admin reactivates a suspended Sales Rep
POST {{baseUrl}}/api/users/00000000-0000-0000-0000-000000000000/activate
Authorization: Bearer {{adminToken}}

### 38) Sales Rep permanently deletes their own account (requires password confirmation)
# WARNING: irreversible — cascades and removes all of this rep's Products/Customers/Orders/RefreshTokens.
DELETE {{baseUrl}}/api/profile
content-Type: application/json
Authorization: Bearer {{salesRepToken}}

{
  "Password":"NewPassword456"
}

### 39) Offline sync - push pending local changes (client-generated ids, real device edit timestamps)
POST {{baseUrl}}/api/sync/push
content-Type: application/json
Authorization: Bearer {{salesRepToken}}

{
  "Customers": [
    { "Id":"00000000-0000-0000-0000-000000000001", "Name":"Offline Client", "StoreName":null, "PhoneNumber":"0777777777", "Street":"St", "City":"Nablus", "IsActive":true, "UpdatedAt":"2026-07-20T15:00:00Z" }
  ],
  "Products": [
    { "Id":"00000000-0000-0000-0000-000000000002", "Name":"Offline Widget", "Description":null, "ImageUrl":null, "PurchasePrice":3, "SellPrice":10, "IsActive":true, "UpdatedAt":"2026-07-20T15:00:00Z" }
  ],
  "Orders": [
    {
      "Id":"00000000-0000-0000-0000-000000000003",
      "CustomerId":"00000000-0000-0000-0000-000000000001",
      "DueDate":"2026-08-01",
      "Discount":0,
      "CashDiscount":0,
      "Notes":"made offline",
      "PaidAmount":0,
      "UpdatedAt":"2026-07-20T15:00:00Z",
      "Items":[ { "ProductId":"00000000-0000-0000-0000-000000000002", "Quantity":4, "UnitPrice":10 } ]
    }
  ]
}

### 40) Offline sync - pull everything changed since the device's last successful sync
# Store the "serverTime" from the response as the new watermark for the next pull - not the device's own clock.
GET {{baseUrl}}/api/sync/pull?since=2026-07-20T00:00:00Z
Authorization: Bearer {{salesRepToken}}

### 41) Self-register a new Sales Rep account - no Admin needed, always starts on a 3-day Trial
# Only the basics: everything else (City, Street, BusinessName, bank details...) is filled in
# later from the app's own settings once logged in.
POST {{baseUrl}}/api/account/register
content-Type: application/json

{
  "UserName":"selfsignup1",
  "Password":"Password123",
  "Name":"Self Signup",
  "PhoneNumber":"0799000098"
}

### 42) Admin changes a Sales Rep's subscription type (Trial, Monthly, Annual, or Lifetime)
# The server recomputes SubscriptionStart (now) and SubscriptionEnd from the type -
# dates are never accepted from the client.
POST {{baseUrl}}/api/users/00000000-0000-0000-0000-000000000000/subscription
content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "SubscriptionType":"Monthly"
}

### 43) Admin lists all users (no password/refresh token in the response)
GET {{baseUrl}}/api/users
Authorization: Bearer {{adminToken}}

### 44) Admin searches users by username or phone number (case-insensitive, partial match)
GET {{baseUrl}}/api/users?search=ahmad
Authorization: Bearer {{adminToken}}

### 45) Admin resets a user's password directly (support tool - no old password needed)
# Also revokes that user's refresh tokens, so any other logged-in device is forced to sign in again.
POST {{baseUrl}}/api/users/00000000-0000-0000-0000-000000000000/reset-password
content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "NewPassword":"NewPassword123"
}

### 46) Admin forgot password - requests an OTP emailed to the configured AdminRecovery address
# Anonymous. Always returns 204 whether or not the username exists/is an Admin (no enumeration).
# Requires the SMTP_PASSWORD environment variable to be set (Gmail App Password) - never stored in appsettings.json.
POST {{baseUrl}}/api/account/forgot-password
content-Type: application/json

{
  "UserName":"mbaboshi"
}

### 47) Admin confirms the OTP from email and sets a new password
# Anonymous. OTP is 6 digits, valid 10 minutes, single-use. Revokes all of the Admin's refresh tokens.
POST {{baseUrl}}/api/account/reset-password
content-Type: application/json

{
  "UserName":"mbaboshi",
  "Otp":"123456",
  "NewPassword":"NewAdminPassword123"
}
